# Porta do painel (padrão 3000)
ADMIN_PORT=3000

# Conexão do painel com a base pedweb_admin (usuários do painel e preferências das listas).
# É só com ela que o painel valida o login; a manutenção das bases usa as credenciais de
# MySQL gravadas na linha de cada usuário (mysql_host, mysql_port, mysql_user, mysql_senha).
PAINEL_MYSQL_HOST=
PAINEL_MYSQL_PORT=3306
PAINEL_MYSQL_USER=
PAINEL_MYSQL_PASSWORD=
